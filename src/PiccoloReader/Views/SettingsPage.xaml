<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="PiccoloReader.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:strings="clr-namespace:PiccoloReader.Core.Resources.Strings;assembly=PiccoloReader.Core"
    Title="{x:Static strings:AppStrings.Settings}">

    <VerticalStackLayout Padding="16" Spacing="12">

        <Label Text="{x:Static strings:AppStrings.LanguageSectionHeader}" FontAttributes="Bold" FontSize="16" />

        <Border Style="{StaticResource ListItemCard}">
            <Picker
                x:Name="LanguagePicker"
                ItemsSource="{Binding LanguageDisplayNames}"
                SelectedIndexChanged="OnLanguagePickerSelectedIndexChanged" />
        </Border>

        <Border Style="{StaticResource ListItemCard}">
            <Grid ColumnDefinitions="*,Auto">
                <Label Grid.Column="0" Text="{x:Static strings:AppStrings.SupportWithAdsOption}" VerticalOptions="Center" />
                <Switch Grid.Column="1" IsToggled="{Binding SupportWithAdsEnabled}" />
            </Grid>
        </Border>

        <Label Text="{x:Static strings:AppStrings.LegalSectionHeader}" FontAttributes="Bold" FontSize="16" Margin="0,8,0,0" />

        <Border Style="{StaticResource ListItemCard}">
            <VerticalStackLayout Spacing="8">
                <Button
                    x:Name="PrivacyPolicyButton"
                    Text="{x:Static strings:AppStrings.PrivacyPolicyLabel}"
                    Clicked="OnPrivacyPolicyClicked"
                    Padding="8,4"
                    CornerRadius="8"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}" />
                <Label
                    Text="{x:Static strings:AppStrings.PrivacyPolicyDescription}"
                    FontSize="12"
                    Opacity="0.7"
                    Margin="0,-4,0,0" />
            </VerticalStackLayout>
        </Border>

        <Border Style="{StaticResource ListItemCard}">
            <VerticalStackLayout Spacing="8">
                <Button
                    x:Name="TermsOfServiceButton"
                    Text="{x:Static strings:AppStrings.TermsOfServiceLabel}"
                    Clicked="OnTermsOfServiceClicked"
                    Padding="8,4"
                    CornerRadius="8"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource Primary}}" />
                <Label
                    Text="{x:Static strings:AppStrings.TermsOfServiceDescription}"
                    FontSize="12"
                    Opacity="0.7"
                    Margin="0,-4,0,0" />
            </VerticalStackLayout>
        </Border>

    </VerticalStackLayout>
</ContentPage>
