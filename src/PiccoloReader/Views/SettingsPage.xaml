<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="PiccoloReader.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PiccoloReader"
    xmlns:strings="clr-namespace:PiccoloReader.Core.Resources.Strings;assembly=PiccoloReader.Core"
    Shell.NavBarIsVisible="False"
    BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}"
    Title="{x:Static strings:AppStrings.Settings}">

    <ContentPage.Resources>
        <!-- Row building blocks: 56dp min height, 20dp icons. -->
        <Style x:Key="RowGrid" TargetType="Grid">
            <Setter Property="MinimumHeightRequest" Value="56" />
            <Setter Property="Padding" Value="16,0,14,0" />
            <Setter Property="ColumnSpacing" Value="14" />
            <Setter Property="BackgroundColor" Value="Transparent" />
        </Style>
        <Style x:Key="RowDivider" TargetType="BoxView">
            <Setter Property="HeightRequest" Value="1" />
            <Setter Property="Color" Value="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}" />
        </Style>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="0,0,0,24">

            <Label
                Style="{StaticResource PageTitle}"
                Text="{x:Static strings:AppStrings.Settings}"
                Padding="20,16,20,0"
                SemanticProperties.HeadingLevel="Level1"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />

            <!-- GENERAL -->
            <VerticalStackLayout Spacing="8" Margin="20,0">
                <Label Style="{StaticResource SectionLabel}" Margin="4,0,0,0" Text="{x:Static strings:AppStrings.SettingsGeneralSection}" />
                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout>
                        <Grid Style="{StaticResource RowGrid}" AutomationId="SettingsLanguageRow" ColumnDefinitions="20,*,Auto,20"
                              SemanticProperties.Description="{x:Static strings:AppStrings.LanguageSectionHeader}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnLanguageRowTapped" />
                            </Grid.GestureRecognizers>
                            <Image Grid.Column="0" VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource Glyph="&#xE894;" FontFamily="MaterialOutlined" Size="20"
                                        Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                                </Image.Source>
                            </Image>
                            <Label Grid.Column="1" Style="{StaticResource RowTitle}" VerticalOptions="Center"
                                   Text="{x:Static strings:AppStrings.LanguageSectionHeader}"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                            <Label Grid.Column="2" x:Name="LanguageValueLabel" AutomationId="SettingsLanguageValue" Style="{StaticResource Caption}" FontSize="14" VerticalOptions="Center" />
                            <Image Grid.Column="3" VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource Glyph="&#xE5CC;" FontFamily="MaterialOutlined" Size="20"
                                        Color="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                                </Image.Source>
                            </Image>
                        </Grid>
                        <BoxView Style="{StaticResource RowDivider}" />
                        <Grid Style="{StaticResource RowGrid}" AutomationId="SettingsTunerStripPositionRow" ColumnDefinitions="20,*,Auto,20"
                              IsVisible="{x:Static local:PlatformInfo.IsAndroid}"
                              SemanticProperties.Description="{x:Static strings:AppStrings.TunerStripPositionLabel}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTunerStripPositionRowTapped" />
                            </Grid.GestureRecognizers>
                            <Image Grid.Column="0" VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource Glyph="&#xE8D4;" FontFamily="MaterialOutlined" Size="20"
                                        Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                                </Image.Source>
                            </Image>
                            <Label Grid.Column="1" Style="{StaticResource RowTitle}" VerticalOptions="Center"
                                   Text="{x:Static strings:AppStrings.TunerStripPositionLabel}"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                            <Label Grid.Column="2" x:Name="TunerStripPositionValueLabel" AutomationId="SettingsTunerStripPositionValue" Style="{StaticResource Caption}" FontSize="14" VerticalOptions="Center" />
                            <Image Grid.Column="3" VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource Glyph="&#xE5CC;" FontFamily="MaterialOutlined" Size="20"
                                        Color="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                                </Image.Source>
                            </Image>
                        </Grid>
                        <BoxView Style="{StaticResource RowDivider}" IsVisible="{x:Static local:PlatformInfo.IsAndroid}" />
                        <Grid Style="{StaticResource RowGrid}" AutomationId="SettingsStylusRow" ColumnDefinitions="20,*,Auto"
                              IsVisible="{x:Static local:PlatformInfo.IsAndroid}">
                            <Image Grid.Column="0" VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource Glyph="&#xE3C9;" FontFamily="MaterialOutlined" Size="20"
                                        Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                                </Image.Source>
                            </Image>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" Padding="0,8">
                                <Label Style="{StaticResource RowTitle}" Text="{x:Static strings:AppStrings.StylusDrawsDirectlyLabel}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                <Label Style="{StaticResource Caption}" FontSize="12" Text="{x:Static strings:AppStrings.StylusDrawsDirectlyDescription}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="2" AutomationId="SettingsStylusSwitch" VerticalOptions="Center"
                                    SemanticProperties.Description="{x:Static strings:AppStrings.StylusDrawsDirectlyLabel}"
                                    OnColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
                                    IsToggled="{Binding StylusDrawsDirectly}" />
                        </Grid>
                        <BoxView Style="{StaticResource RowDivider}" />
                        <Grid Style="{StaticResource RowGrid}" AutomationId="SettingsRecognizeShapesRow" ColumnDefinitions="20,*,Auto">
                            <Image Grid.Column="0" VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource Glyph="&#xE663;" FontFamily="MaterialOutlined" Size="20"
                                        Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                                </Image.Source>
                            </Image>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" Padding="0,8">
                                <Label Style="{StaticResource RowTitle}" Text="{x:Static strings:AppStrings.RecognizeShapesLabel}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                <Label Style="{StaticResource Caption}" FontSize="12" Text="{x:Static strings:AppStrings.RecognizeShapesDescription}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="2" AutomationId="SettingsRecognizeShapesSwitch" VerticalOptions="Center"
                                    SemanticProperties.Description="{x:Static strings:AppStrings.RecognizeShapesLabel}"
                                    OnColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
                                    IsToggled="{Binding RecognizeShapes}" />
                        </Grid>
                        <BoxView Style="{StaticResource RowDivider}" IsVisible="{x:Static local:PlatformInfo.IsAndroid}" />
                        <Grid Style="{StaticResource RowGrid}" AutomationId="SettingsConcertModeRow" ColumnDefinitions="20,*,Auto">
                            <Image Grid.Column="0" VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource Glyph="&#xE03D;" FontFamily="MaterialOutlined" Size="20"
                                        Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                                </Image.Source>
                            </Image>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" Padding="0,8">
                                <Label Style="{StaticResource RowTitle}" Text="{x:Static strings:AppStrings.ConcertModeLabel}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                <Label Style="{StaticResource Caption}" FontSize="12" Text="{x:Static strings:AppStrings.ConcertModeDescription}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="2" AutomationId="SettingsConcertModeSwitch" VerticalOptions="Center"
                                    SemanticProperties.Description="{x:Static strings:AppStrings.ConcertModeLabel}"
                                    OnColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
                                    IsToggled="{Binding ConcertModeEnabled}" />
                        </Grid>
                        <BoxView Style="{StaticResource RowDivider}" />
                        <Grid Style="{StaticResource RowGrid}" AutomationId="SettingsConcertTutorialRow" ColumnDefinitions="20,*,Auto">
                            <Image Grid.Column="0" VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource Glyph="&#xE80C;" FontFamily="MaterialOutlined" Size="20"
                                        Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                                </Image.Source>
                            </Image>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" Padding="0,8">
                                <Label Style="{StaticResource RowTitle}" Text="{x:Static strings:AppStrings.ConcertTutorialLabel}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                <Label Style="{StaticResource Caption}" FontSize="12" Text="{x:Static strings:AppStrings.ConcertTutorialDescription}" />
                            </VerticalStackLayout>
                            <Switch Grid.Column="2" AutomationId="SettingsConcertTutorialSwitch" VerticalOptions="Center"
                                    SemanticProperties.Description="{x:Static strings:AppStrings.ConcertTutorialLabel}"
                                    OnColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}"
                                    IsToggled="{Binding ConcertTutorialEnabled}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ALMACENAMIENTO -->
            <VerticalStackLayout Spacing="8" Margin="20,0">
                <Label Style="{StaticResource SectionLabel}" Margin="4,0,0,0" Text="{x:Static strings:AppStrings.SettingsStorageSection}" />
                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout>
                        <Grid Style="{StaticResource RowGrid}" AutomationId="SettingsStorageLocationRow" ColumnDefinitions="20,*"
                              SemanticProperties.Description="{x:Static strings:AppStrings.StorageLocationLabel}">
                            <Image Grid.Column="0" VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource Glyph="&#xE2C7;" FontFamily="MaterialOutlined" Size="20"
                                        Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                                </Image.Source>
                            </Image>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" Padding="0,8">
                                <Label Style="{StaticResource RowTitle}" Text="{x:Static strings:AppStrings.StorageLocationLabel}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                <Label AutomationId="SettingsStorageLocationValue" Style="{StaticResource Caption}" FontSize="12" Text="{x:Static strings:AppStrings.StorageLocationValue}" />
                                <Label x:Name="StorageSyncLabel" AutomationId="SettingsStorageSyncValue" Style="{StaticResource Caption}" FontSize="12" />
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView Style="{StaticResource RowDivider}" />
                        <Grid Style="{StaticResource RowGrid}" AutomationId="SettingsRecoverLibraryRow" ColumnDefinitions="20,*,20"
                              SemanticProperties.Description="{x:Static strings:AppStrings.RecoverLibraryLabel}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnRecoverLibraryTapped" />
                            </Grid.GestureRecognizers>
                            <Image Grid.Column="0" VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource Glyph="&#xE8B3;" FontFamily="MaterialOutlined" Size="20"
                                        Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                                </Image.Source>
                            </Image>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" Padding="0,8">
                                <Label Style="{StaticResource RowTitle}" Text="{x:Static strings:AppStrings.RecoverLibraryLabel}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                <Label Style="{StaticResource Caption}" FontSize="12" Text="{x:Static strings:AppStrings.RecoverLibraryDescription}" />
                            </VerticalStackLayout>
                            <Image Grid.Column="2" VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource Glyph="&#xE5CC;" FontFamily="MaterialOutlined" Size="20"
                                        Color="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                                </Image.Source>
                            </Image>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- AYUDA -->
            <VerticalStackLayout Spacing="8" Margin="20,0">
                <Label Style="{StaticResource SectionLabel}" Margin="4,0,0,0" Text="{x:Static strings:AppStrings.SettingsHelpSection}" />
                <Border Style="{StaticResource Card}" Padding="0">
                    <Grid Style="{StaticResource RowGrid}" AutomationId="SettingsTutorialRow" ColumnDefinitions="20,*,20"
                          SemanticProperties.Description="{x:Static strings:AppStrings.ShowTutorial}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnShowTutorialClicked" />
                        </Grid.GestureRecognizers>
                        <Image Grid.Column="0" VerticalOptions="Center">
                            <Image.Source>
                                <FontImageSource Glyph="&#xE8FD;" FontFamily="MaterialOutlined" Size="20"
                                    Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                            </Image.Source>
                        </Image>
                        <Label Grid.Column="1" Style="{StaticResource RowTitle}" VerticalOptions="Center"
                               Text="{x:Static strings:AppStrings.ShowTutorial}"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        <Image Grid.Column="2" VerticalOptions="Center">
                            <Image.Source>
                                <FontImageSource Glyph="&#xE5CC;" FontFamily="MaterialOutlined" Size="20"
                                    Color="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                            </Image.Source>
                        </Image>
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- LEGAL -->
            <VerticalStackLayout Spacing="8" Margin="20,0">
                <Label Style="{StaticResource SectionLabel}" Margin="4,0,0,0" Text="{x:Static strings:AppStrings.LegalSectionHeader}" />
                <Border Style="{StaticResource Card}" Padding="0">
                    <VerticalStackLayout>
                        <Grid Style="{StaticResource RowGrid}" AutomationId="SettingsPrivacyRow" ColumnDefinitions="20,*,20"
                              SemanticProperties.Description="{x:Static strings:AppStrings.PrivacyPolicyLabel}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnPrivacyPolicyClicked" />
                            </Grid.GestureRecognizers>
                            <Image Grid.Column="0" VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource Glyph="&#xE32A;" FontFamily="MaterialOutlined" Size="20"
                                        Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                                </Image.Source>
                            </Image>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" Padding="0,8">
                                <Label Style="{StaticResource RowTitle}" Text="{x:Static strings:AppStrings.PrivacyPolicyLabel}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                <Label Style="{StaticResource Caption}" FontSize="12" Text="{x:Static strings:AppStrings.PrivacyPolicyDescription}" />
                            </VerticalStackLayout>
                            <Image Grid.Column="2" VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource Glyph="&#xE89E;" FontFamily="MaterialOutlined" Size="20"
                                        Color="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                                </Image.Source>
                            </Image>
                        </Grid>
                        <BoxView Style="{StaticResource RowDivider}" />
                        <Grid Style="{StaticResource RowGrid}" AutomationId="SettingsTermsRow" ColumnDefinitions="20,*,20"
                              SemanticProperties.Description="{x:Static strings:AppStrings.TermsOfServiceLabel}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnTermsOfServiceClicked" />
                            </Grid.GestureRecognizers>
                            <Image Grid.Column="0" VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource Glyph="&#xE873;" FontFamily="MaterialOutlined" Size="20"
                                        Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                                </Image.Source>
                            </Image>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" Padding="0,8">
                                <Label Style="{StaticResource RowTitle}" Text="{x:Static strings:AppStrings.TermsOfServiceLabel}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                <Label Style="{StaticResource Caption}" FontSize="12" Text="{x:Static strings:AppStrings.TermsOfServiceDescription}" />
                            </VerticalStackLayout>
                            <Image Grid.Column="2" VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource Glyph="&#xE89E;" FontFamily="MaterialOutlined" Size="20"
                                        Color="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                                </Image.Source>
                            </Image>
                        </Grid>
                        <BoxView Style="{StaticResource RowDivider}" />
                        <Grid Style="{StaticResource RowGrid}" AutomationId="SettingsMuseScoreCreditRow" ColumnDefinitions="20,*,20"
                              SemanticProperties.Description="{x:Static strings:AppStrings.SettingsMuseScoreCreditTitle}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMuseScoreCreditClicked" />
                            </Grid.GestureRecognizers>
                            <Image Grid.Column="0" VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource Glyph="&#xE405;" FontFamily="MaterialOutlined" Size="20"
                                        Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                                </Image.Source>
                            </Image>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" Padding="0,8">
                                <Label Style="{StaticResource RowTitle}" Text="{x:Static strings:AppStrings.SettingsMuseScoreCreditTitle}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                <Label Style="{StaticResource Caption}" FontSize="12" Text="{x:Static strings:AppStrings.SettingsMuseScoreCreditDescription}" />
                            </VerticalStackLayout>
                            <Image Grid.Column="2" VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource Glyph="&#xE89E;" FontFamily="MaterialOutlined" Size="20"
                                        Color="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                                </Image.Source>
                            </Image>
                        </Grid>
                        <BoxView Style="{StaticResource RowDivider}" />
                        <Grid Style="{StaticResource RowGrid}" AutomationId="SettingsMeltySynthCreditRow" ColumnDefinitions="20,*,20"
                              SemanticProperties.Description="{x:Static strings:AppStrings.SettingsMeltySynthCreditTitle}">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMeltySynthCreditClicked" />
                            </Grid.GestureRecognizers>
                            <Image Grid.Column="0" VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource Glyph="&#xE322;" FontFamily="MaterialOutlined" Size="20"
                                        Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                                </Image.Source>
                            </Image>
                            <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center" Padding="0,8">
                                <Label Style="{StaticResource RowTitle}" Text="{x:Static strings:AppStrings.SettingsMeltySynthCreditTitle}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                <Label Style="{StaticResource Caption}" FontSize="12" Text="{x:Static strings:AppStrings.SettingsMeltySynthCreditDescription}" />
                            </VerticalStackLayout>
                            <Image Grid.Column="2" VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource Glyph="&#xE89E;" FontFamily="MaterialOutlined" Size="20"
                                        Color="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                                </Image.Source>
                            </Image>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- Footer -->
            <VerticalStackLayout Spacing="0" HorizontalOptions="Center" Margin="0,8,0,0">
                <Label x:Name="VersionLabel" Style="{StaticResource Caption}" FontSize="12" HorizontalTextAlignment="Center" />
                <!-- One Label per credit line so prefix and link share a baseline; the whole line is the tap target -->
                <Label AutomationId="SettingsCreditLink" Style="{StaticResource Caption}" FontSize="12"
                       HorizontalTextAlignment="Center" Margin="0,16,0,0" Padding="0,8">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{x:Static strings:AppStrings.MadeWithLoveBy}" />
                            <Span Text=" " />
                            <Span Text="@fsoftt" TextDecorations="Underline"
                                  TextColor="{AppThemeBinding Light={StaticResource OnPrimaryContainerLight}, Dark={StaticResource OnPrimaryContainerDark}}" />
                        </FormattedString>
                    </Label.FormattedText>
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCreditLinkTapped" />
                    </Label.GestureRecognizers>
                </Label>
                <Label AutomationId="SettingsTesterCreditLink" Style="{StaticResource Caption}" FontSize="12"
                       HorizontalTextAlignment="Center" Padding="0,8">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{x:Static strings:AppStrings.TestedWithLoveBy}" />
                            <Span Text=" " />
                            <Span Text="@giomelchors" TextDecorations="Underline"
                                  TextColor="{AppThemeBinding Light={StaticResource OnPrimaryContainerLight}, Dark={StaticResource OnPrimaryContainerDark}}" />
                        </FormattedString>
                    </Label.FormattedText>
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTesterCreditLinkTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
