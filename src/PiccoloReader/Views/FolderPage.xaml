<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="PiccoloReader.Views.FolderPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:converters="clr-namespace:PiccoloReader.Converters"
    xmlns:strings="clr-namespace:PiccoloReader.Core.Resources.Strings;assembly=PiccoloReader.Core"
    xmlns:admob="clr-namespace:Plugin.AdMob;assembly=Plugin.AdMob"
    xmlns:local="clr-namespace:PiccoloReader"
    x:Name="ThisPage"
    Shell.TabBarIsVisible="False"
    Shell.NavBarIsVisible="False"
    Title="{x:Static strings:AppStrings.Folder}">

    <ContentPage.Resources>
        <converters:StringNotEmptyConverter x:Key="StringNotEmpty" />
        <converters:SheetMetaConverter x:Key="SheetMeta" />
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">
        <CollectionView
            Grid.Row="0"
            ItemsSource="{Binding Sheets}"
            SelectionMode="None">
            <CollectionView.Header>
                <VerticalStackLayout Spacing="0">

                    <!-- Compact header: back, folder name + count, import -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="4" Padding="8,12,20,12">
                        <ImageButton
                            Grid.Column="0"
                            AutomationId="FolderBackButton"
                            SemanticProperties.Description="{x:Static strings:AppStrings.BackLabel}"
                            Style="{StaticResource IconButton}"
                            VerticalOptions="Start"
                            Clicked="OnBackClicked">
                            <ImageButton.Source>
                                <FontImageSource Glyph="&#xE5C4;" FontFamily="MaterialOutlined" Size="24"
                                    Color="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                            </ImageButton.Source>
                        </ImageButton>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label
                                AutomationId="FolderTitleLabel"
                                Style="{StaticResource PageTitle}"
                                FontSize="26"
                                MaxLines="1"
                                LineBreakMode="TailTruncation"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                Text="{Binding Title, Source={x:Reference ThisPage}}" />
                            <Label Style="{StaticResource Caption}" Text="{Binding SummaryText}" />
                        </VerticalStackLayout>
                        <ImageButton
                            Grid.Column="2"
                            AutomationId="FolderImportButton"
                            SemanticProperties.Description="{x:Static strings:AppStrings.ImportPdf}"
                            Style="{StaticResource IconButton}"
                            VerticalOptions="Start"
                            CornerRadius="22" BorderWidth="1"
                            BorderColor="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                            Clicked="OnImportPdfClicked">
                            <ImageButton.Source>
                                <FontImageSource Glyph="&#xE2C6;" FontFamily="MaterialOutlined" Size="24"
                                    Color="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                            </ImageButton.Source>
                        </ImageButton>
                    </Grid>

                    <!-- Search + sort -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="20,4,20,12" IsVisible="{Binding HasMultipleSheets}">
                        <Border
                            Grid.Column="0"
                            HeightRequest="44"
                            Padding="14,0"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Image Grid.Column="0" VerticalOptions="Center">
                                    <Image.Source>
                                        <FontImageSource Glyph="&#xE8B6;" FontFamily="MaterialOutlined" Size="20"
                                            Color="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                                    </Image.Source>
                                </Image>
                                <Entry
                                    Grid.Column="1"
                                    AutomationId="FolderSearchEntry"
                                    FontSize="15"
                                    VerticalOptions="Center"
                                    Placeholder="{x:Static strings:AppStrings.SearchSheetsPlaceholder}"
                                    PlaceholderColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                                    Text="{Binding SearchText}" />
                                <ImageButton
                                    Grid.Column="2"
                                    AutomationId="FolderSearchClearButton"
                                    Style="{StaticResource IconButton}"
                                    Margin="-10,0,-14,0"
                                    IsVisible="{Binding SearchText, Converter={StaticResource StringNotEmpty}}"
                                    Clicked="OnSearchClearClicked">
                                    <ImageButton.Source>
                                        <FontImageSource Glyph="&#xE5CD;" FontFamily="MaterialOutlined" Size="20"
                                            Color="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                                    </ImageButton.Source>
                                </ImageButton>
                            </Grid>
                        </Border>
                        <ImageButton
                            Grid.Column="1"
                            AutomationId="FolderSortButton"
                            SemanticProperties.Description="{x:Static strings:AppStrings.SortLabel}"
                            Style="{StaticResource IconButton}"
                            CornerRadius="14" BorderWidth="1"
                            BorderColor="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                            Clicked="OnSortClicked">
                            <ImageButton.Source>
                                <FontImageSource Glyph="&#xE164;" FontFamily="MaterialOutlined" Size="20"
                                    Color="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                            </ImageButton.Source>
                        </ImageButton>
                    </Grid>

                    <Label
                        Style="{StaticResource SectionLabel}"
                        Padding="20,4,20,6"
                        Text="{x:Static strings:AppStrings.Sheets}"
                        IsVisible="{Binding HasResults}" />

                    <!-- Compact empty state: search with no matches -->
                    <VerticalStackLayout IsVisible="{Binding HasNoSearchResults}" Spacing="4" Margin="32,40,32,24" AutomationId="FolderNoResults">
                        <Image HorizontalOptions="Center" Margin="0,0,0,6">
                            <Image.Source>
                                <FontImageSource Glyph="&#xE8B6;" FontFamily="MaterialOutlined" Size="32"
                                    Color="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                            </Image.Source>
                        </Image>
                        <Label Style="{StaticResource RowTitle}" HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                               Text="{x:Static strings:AppStrings.NoResultsTitle}" />
                        <Label Style="{StaticResource Caption}" HorizontalTextAlignment="Center"
                               Text="{x:Static strings:AppStrings.NoResultsMessage}" />
                    </VerticalStackLayout>

                    <!-- Compact empty state: empty folder -->
                    <VerticalStackLayout IsVisible="{Binding IsFolderEmpty}" Spacing="4" Margin="32,40,32,24" AutomationId="FolderEmpty">
                        <Image HorizontalOptions="Center" Margin="0,0,0,6">
                            <Image.Source>
                                <FontImageSource Glyph="&#xE2C7;" FontFamily="MaterialOutlined" Size="40"
                                    Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                            </Image.Source>
                        </Image>
                        <Label Style="{StaticResource RowTitle}" HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                               Text="{x:Static strings:AppStrings.EmptyFolderTitle}" />
                        <Label Style="{StaticResource Caption}" HorizontalTextAlignment="Center"
                               Text="{x:Static strings:AppStrings.EmptyFolderMessage}" />
                        <Border
                            AutomationId="FolderEmptyImportButton"
                            Margin="0,12,0,0"
                            HorizontalOptions="Center"
                            Padding="20,0"
                            HeightRequest="44"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 22"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnImportPdfClicked" />
                            </Border.GestureRecognizers>
                            <Label Text="{x:Static strings:AppStrings.ImportPdf}" VerticalOptions="Center" FontSize="14" FontFamily="OpenSansSemibold"
                                   TextColor="{AppThemeBinding Light={StaticResource OnPrimaryLight}, Dark={StaticResource OnPrimaryDark}}" />
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid AutomationId="LibrarySheetRow" ColumnDefinitions="*,Auto" Padding="20,8,8,8" BackgroundColor="Transparent">
                      <!-- Tap/long-press area; the more button is a sibling so its tap does not open the sheet. -->
                      <Grid x:Name="SheetItemRoot" ColumnDefinitions="Auto,*" ColumnSpacing="14" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSheetTapped" CommandParameter="{Binding}" />
                        </Grid.GestureRecognizers>
                        <Grid.Behaviors>
                            <toolkit:TouchBehavior
                                InteractionStatusChanged="OnItemTouchStatusChanged"
                                PressedOpacity="0.6"
                                LongPressCommand="{Binding Source={x:Reference ThisPage}, Path=SheetLongPressCommand}"
                                LongPressCommandParameter="{Binding Source={x:Reference SheetItemRoot}, Path=BindingContext}" />
                        </Grid.Behaviors>

                        <Border
                            Grid.Column="0"
                            WidthRequest="40" HeightRequest="54"
                            Padding="6,0"
                            StrokeShape="RoundRectangle 6"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource OutlineLight}, Dark=Transparent}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource TextPrimaryDark}}">
                            <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                                <BoxView HeightRequest="1" Color="#9A9AAE" />
                                <BoxView HeightRequest="1" Color="#9A9AAE" />
                                <BoxView HeightRequest="1" Color="#9A9AAE" />
                                <BoxView HeightRequest="1" Color="#9A9AAE" />
                            </VerticalStackLayout>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Style="{StaticResource RowTitle}" MaxLines="1" LineBreakMode="TailTruncation"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                   Text="{Binding Title}" />
                            <Label Style="{StaticResource Caption}" MaxLines="1" LineBreakMode="TailTruncation"
                                   Text="{Binding ., Converter={StaticResource SheetMeta}}" />
                        </VerticalStackLayout>

                        </Grid>

                        <ImageButton
                            Grid.Column="1"
                            AutomationId="LibraryItemMoreButton"
                            SemanticProperties.Description="{x:Static strings:AppStrings.MoreOptions}"
                            Style="{StaticResource IconButton}"
                            VerticalOptions="Center"
                            Clicked="OnSheetMoreClicked">
                            <ImageButton.Source>
                                <FontImageSource Glyph="&#xE5D4;" FontFamily="MaterialOutlined" Size="20"
                                    Color="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                            </ImageButton.Source>
                        </ImageButton>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <Grid HeightRequest="16" />
            </CollectionView.Footer>
        </CollectionView>

        <Grid Grid.Row="1" IsVisible="{x:Static local:PlatformInfo.IsAndroid}">
            <admob:BannerAd IsVisible="{Binding ShowAdsBanner}" />
        </Grid>
    </Grid>
</ContentPage>
