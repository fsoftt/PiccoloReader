<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="PiccoloReader.Views.SplashPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:skia="clr-namespace:SkiaSharp.Extended.UI.Controls;assembly=SkiaSharp.Extended.UI.Maui"
    BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}"
    NavigationPage.HasNavigationBar="False">

    <Grid RowDefinitions="*,Auto,*,Auto" Padding="32">

        <skia:SKLottieView
            x:Name="LottieView"
            Grid.Row="1"
            Source="musical-notes.json"
            RepeatCount="0"
            AnimationCompleted="OnAnimationCompleted"
            HorizontalOptions="Center"
            WidthRequest="280"
            HeightRequest="280" />

        <VerticalStackLayout
            Grid.Row="3"
            Spacing="0"
            HorizontalOptions="Center"
            Margin="0,0,0,24">
            <Label
                Text="Piccolo"
                FontFamily="Pacifico"
                FontSize="44"
                TextColor="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource OnPrimaryContainerDark}}"
                HorizontalOptions="Center" />
            <Label
                Text="Music Reader by fsoftt"
                FontFamily="OpenSansSemibold"
                FontSize="14"
                CharacterSpacing="1"
                TextColor="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource OnPrimaryContainerDark}}"
                Opacity="0.7"
                HorizontalOptions="Center" />
        </VerticalStackLayout>

    </Grid>
</ContentPage>
