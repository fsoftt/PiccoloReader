<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="PiccoloReader.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:converters="clr-namespace:PiccoloReader.Converters"
    x:Name="ThisPage"
    Title="Library">

    <ContentPage.Resources>
        <converters:StringNotEmptyConverter x:Key="StringNotEmpty" />
    </ContentPage.Resources>

    <Shell.TitleView>
        <Label
            Text="Piccolo"
            FontFamily="Pacifico"
            FontSize="26"
            TextColor="{StaticResource White}"
            VerticalOptions="Center" />
    </Shell.TitleView>

    <Grid>
        <VerticalStackLayout Padding="16,16,16,144" Spacing="12">

        <CollectionView
            ItemsSource="{Binding Folders}"
            IsVisible="{Binding HasFolders}">
            <CollectionView.Header>
                <Grid RowDefinitions="Auto,Auto" Margin="0,0,0,4">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
                        <Label Grid.Column="0" Text="Folders" FontAttributes="Bold" VerticalOptions="Center" />
                        <Border
                            Grid.Column="1"
                            Padding="6"
                            StrokeThickness="0"
                            BackgroundColor="Transparent"
                            IsVisible="{Binding HasMultipleFolders}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFolderSearchClicked" />
                            </Border.GestureRecognizers>
                            <Image>
                                <Image.Source>
                                    <FontImageSource
                                        Glyph="&#xE8B6;"
                                        FontFamily="MaterialOutlined"
                                        Size="20"
                                        Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                </Image.Source>
                            </Image>
                        </Border>
                        <Border
                            Grid.Column="2"
                            Padding="6"
                            StrokeThickness="0"
                            BackgroundColor="Transparent"
                            IsVisible="{Binding HasMultipleFolders}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFolderSortClicked" />
                            </Border.GestureRecognizers>
                            <Image>
                                <Image.Source>
                                    <FontImageSource
                                        Glyph="&#xE164;"
                                        FontFamily="MaterialOutlined"
                                        Size="20"
                                        Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                </Image.Source>
                            </Image>
                        </Border>
                    </Grid>
                    <Grid
                        Grid.Row="1"
                        ColumnDefinitions="*,Auto"
                        Margin="0,8,0,0"
                        IsVisible="{Binding IsFolderSearchVisible}">
                        <Entry
                            Grid.Column="0"
                            Placeholder="Search folders"
                            Text="{Binding FolderSearchText}" />
                        <Border
                            Grid.Column="1"
                            Padding="6"
                            StrokeThickness="0"
                            BackgroundColor="Transparent"
                            IsVisible="{Binding FolderSearchText, Converter={StaticResource StringNotEmpty}}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnFolderSearchClearClicked" />
                            </Border.GestureRecognizers>
                            <Image>
                                <Image.Source>
                                    <FontImageSource
                                        Glyph="&#xE5CD;"
                                        FontFamily="MaterialOutlined"
                                        Size="18"
                                        Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                </Image.Source>
                            </Image>
                        </Border>
                    </Grid>
                </Grid>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="FolderItemRoot" Style="{StaticResource ListItemCard}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFolderTapped" CommandParameter="{Binding}" />
                        </Border.GestureRecognizers>
                        <Border.Behaviors>
                            <toolkit:TouchBehavior
                                LongPressCommand="{Binding Source={x:Reference ThisPage}, Path=FolderLongPressCommand}"
                                LongPressCommandParameter="{Binding Source={x:Reference FolderItemRoot}, Path=BindingContext}" />
                        </Border.Behaviors>
                        <HorizontalStackLayout Spacing="12">
                            <Image>
                                <Image.Source>
                                    <FontImageSource
                                        Glyph="&#xE2C7;"
                                        FontFamily="MaterialOutlined"
                                        Size="24"
                                        Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                </Image.Source>
                            </Image>
                            <Label Text="{Binding Name}" VerticalOptions="Center" FontSize="16" />
                        </HorizontalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <CollectionView
            ItemsSource="{Binding RootSheets}"
            IsVisible="{Binding HasRootSheets}">
            <CollectionView.Header>
                <Grid RowDefinitions="Auto,Auto" Margin="0,0,0,4">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto">
                        <Label Grid.Column="0" Text="Sheets" FontAttributes="Bold" VerticalOptions="Center" />
                        <Border
                            Grid.Column="1"
                            Padding="6"
                            StrokeThickness="0"
                            BackgroundColor="Transparent"
                            IsVisible="{Binding HasMultipleRootSheets}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSheetSearchClicked" />
                            </Border.GestureRecognizers>
                            <Image>
                                <Image.Source>
                                    <FontImageSource
                                        Glyph="&#xE8B6;"
                                        FontFamily="MaterialOutlined"
                                        Size="20"
                                        Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                </Image.Source>
                            </Image>
                        </Border>
                        <Border
                            Grid.Column="2"
                            Padding="6"
                            StrokeThickness="0"
                            BackgroundColor="Transparent"
                            IsVisible="{Binding HasMultipleRootSheets}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSheetSortClicked" />
                            </Border.GestureRecognizers>
                            <Image>
                                <Image.Source>
                                    <FontImageSource
                                        Glyph="&#xE164;"
                                        FontFamily="MaterialOutlined"
                                        Size="20"
                                        Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                </Image.Source>
                            </Image>
                        </Border>
                    </Grid>
                    <Grid
                        Grid.Row="1"
                        ColumnDefinitions="*,Auto"
                        Margin="0,8,0,0"
                        IsVisible="{Binding IsSheetSearchVisible}">
                        <Entry
                            Grid.Column="0"
                            Placeholder="Search sheets"
                            Text="{Binding SheetSearchText}" />
                        <Border
                            Grid.Column="1"
                            Padding="6"
                            StrokeThickness="0"
                            BackgroundColor="Transparent"
                            IsVisible="{Binding SheetSearchText, Converter={StaticResource StringNotEmpty}}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSheetSearchClearClicked" />
                            </Border.GestureRecognizers>
                            <Image>
                                <Image.Source>
                                    <FontImageSource
                                        Glyph="&#xE5CD;"
                                        FontFamily="MaterialOutlined"
                                        Size="18"
                                        Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                </Image.Source>
                            </Image>
                        </Border>
                    </Grid>
                </Grid>
            </CollectionView.Header>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border x:Name="SheetItemRoot" Style="{StaticResource ListItemCard}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSheetTapped" CommandParameter="{Binding}" />
                        </Border.GestureRecognizers>
                        <Border.Behaviors>
                            <toolkit:TouchBehavior
                                LongPressCommand="{Binding Source={x:Reference ThisPage}, Path=SheetLongPressCommand}"
                                LongPressCommandParameter="{Binding Source={x:Reference SheetItemRoot}, Path=BindingContext}" />
                        </Border.Behaviors>
                        <HorizontalStackLayout Spacing="12">
                            <Image>
                                <Image.Source>
                                    <FontImageSource
                                        Glyph="&#xE873;"
                                        FontFamily="MaterialOutlined"
                                        Size="24"
                                        Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                </Image.Source>
                            </Image>
                            <Label Text="{Binding Title}" VerticalOptions="Center" FontSize="16" />
                        </HorizontalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        </VerticalStackLayout>

        <!-- Mini FAB: secondary action (Import), stacked above the main FAB and centered on the same axis (24 = 16 + (56-40)/2, so both FABs share a center line rather than a right edge). -->
        <Border
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,24,88"
            WidthRequest="40"
            HeightRequest="40"
            Padding="0"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 20"
            BackgroundColor="{StaticResource Primary}">
            <Border.Shadow>
                <Shadow Brush="{StaticResource Black}" Opacity="0.3" Radius="6" Offset="0,3" />
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnImportPdfClicked" />
            </Border.GestureRecognizers>
            <Image HorizontalOptions="Center" VerticalOptions="Center">
                <Image.Source>
                    <FontImageSource Glyph="&#xE2C6;" FontFamily="MaterialOutlined" Size="18" Color="{StaticResource White}" />
                </Image.Source>
            </Image>
        </Border>

        <!-- Main FAB: primary action (Add Folder). -->
        <Border
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,16,16"
            WidthRequest="56"
            HeightRequest="56"
            Padding="0"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 28"
            BackgroundColor="{StaticResource Primary}">
            <Border.Shadow>
                <Shadow Brush="{StaticResource Black}" Opacity="0.3" Radius="8" Offset="0,4" />
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCreateFolderClicked" />
            </Border.GestureRecognizers>
            <Image HorizontalOptions="Center" VerticalOptions="Center">
                <Image.Source>
                    <FontImageSource Glyph="&#xE2CC;" FontFamily="MaterialOutlined" Size="24" Color="{StaticResource White}" />
                </Image.Source>
            </Image>
        </Border>
    </Grid>
</ContentPage>
