<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="PiccoloReader.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
    xmlns:converters="clr-namespace:PiccoloReader.Converters"
    xmlns:strings="clr-namespace:PiccoloReader.Core.Resources.Strings;assembly=PiccoloReader.Core"
    xmlns:admob="clr-namespace:Plugin.AdMob;assembly=Plugin.AdMob"
    xmlns:local="clr-namespace:PiccoloReader"
    x:Name="ThisPage"
    Shell.NavBarIsVisible="False"
    Title="{x:Static strings:AppStrings.Library}">

    <ContentPage.Resources>
        <DataTemplate x:Key="FolderCardTemplate">
            <Grid x:Name="FolderItemRoot" AutomationId="LibraryFolderCard" BackgroundColor="Transparent">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnFolderTapped" CommandParameter="{Binding}" />
                </Grid.GestureRecognizers>
                <Grid.Behaviors>
                    <toolkit:TouchBehavior
                        InteractionStatusChanged="OnItemTouchStatusChanged"
                        PressedOpacity="0.6"
                        LongPressCommand="{Binding Source={x:Reference ThisPage}, Path=FolderLongPressCommand}"
                        LongPressCommandParameter="{Binding Source={x:Reference FolderItemRoot}, Path=BindingContext}" />
                </Grid.Behaviors>
                <Border Style="{StaticResource Card}" StrokeShape="RoundRectangle 16" Padding="12">
                    <VerticalStackLayout Spacing="10">
                        <Image HorizontalOptions="Start">
                            <Image.Source>
                                <FontImageSource Glyph="&#xE2C7;" FontFamily="MaterialOutlined" Size="20"
                                    Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                            </Image.Source>
                        </Image>
                        <VerticalStackLayout Spacing="2">
                            <Label Style="{StaticResource RowTitle}" FontSize="14" MaxLines="1" LineBreakMode="TailTruncation"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                   AutomationId="LibraryFolderName" Text="{Binding Name}" />
                            <Label Style="{StaticResource Caption}" FontSize="12" MaxLines="1" LineBreakMode="TailTruncation"
                                   Text="{Binding SheetCount, Converter={StaticResource SheetCount}}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </DataTemplate>
        <converters:StringNotEmptyConverter x:Key="StringNotEmpty" />
        <converters:SheetMetaConverter x:Key="SheetMeta" />
        <converters:SheetCountConverter x:Key="SheetCount" />
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">
        <CollectionView
            Grid.Row="0"
            ItemsSource="{Binding RootSheets}"
            SelectionMode="None">
            <CollectionView.Header>
                <VerticalStackLayout Spacing="0">

                    <!-- Page header: title + summary, new folder / import actions. -->
                    <Grid ColumnDefinitions="*,Auto" Padding="20,16,20,12">
                        <VerticalStackLayout Grid.Column="0" Spacing="4" VerticalOptions="Center">
                            <Label Style="{StaticResource PageTitle}" Text="{x:Static strings:AppStrings.Library}"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                            <Label Style="{StaticResource Caption}" Text="{Binding SummaryText}" />
                        </VerticalStackLayout>
                        <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Start">
                            <ImageButton
                                AutomationId="LibraryNewFolderButton"
                                SemanticProperties.Description="{x:Static strings:AppStrings.NewFolder}"
                                Style="{StaticResource IconButton}"
                                CornerRadius="22" BorderWidth="1"
                                BorderColor="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                Clicked="OnCreateFolderClicked">
                                <ImageButton.Source>
                                    <FontImageSource Glyph="&#xE2CC;" FontFamily="MaterialOutlined" Size="24"
                                        Color="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                </ImageButton.Source>
                            </ImageButton>
                            <ImageButton
                                AutomationId="LibraryImportButton"
                                SemanticProperties.Description="{x:Static strings:AppStrings.ImportPdf}"
                                Style="{StaticResource IconButton}"
                                CornerRadius="22" BorderWidth="1"
                                BorderColor="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                                Clicked="OnImportPdfClicked">
                                <ImageButton.Source>
                                    <FontImageSource Glyph="&#xE2C6;" FontFamily="MaterialOutlined" Size="24"
                                        Color="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                </ImageButton.Source>
                            </ImageButton>
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- Sheet search + sort -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="20,8,20,12" IsVisible="{Binding HasMultipleRootSheets}">
                        <Border
                            Grid.Column="0"
                            HeightRequest="44"
                            Padding="14,0"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <Image Grid.Column="0" VerticalOptions="Center">
                                    <Image.Source>
                                        <FontImageSource Glyph="&#xE8B6;" FontFamily="MaterialOutlined" Size="20"
                                            Color="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                                    </Image.Source>
                                </Image>
                                <Entry
                                    Grid.Column="1"
                                    x:Name="SheetSearchEntry"
                                    AutomationId="LibrarySearchEntry"
                                    FontSize="15"
                                    VerticalOptions="Center"
                                    Placeholder="{x:Static strings:AppStrings.SearchSheetsPlaceholder}"
                                    PlaceholderColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                                    Text="{Binding SheetSearchText}" />
                                <ImageButton
                                    Grid.Column="2"
                                    AutomationId="LibrarySearchClearButton"
                                    Style="{StaticResource IconButton}"
                                    Margin="-10,0,-14,0"
                                    IsVisible="{Binding SheetSearchText, Converter={StaticResource StringNotEmpty}}"
                                    Clicked="OnSheetSearchClearClicked">
                                    <ImageButton.Source>
                                        <FontImageSource Glyph="&#xE5CD;" FontFamily="MaterialOutlined" Size="20"
                                            Color="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                                    </ImageButton.Source>
                                </ImageButton>
                            </Grid>
                        </Border>
                        <ImageButton
                            Grid.Column="1"
                            AutomationId="LibrarySortButton"
                            SemanticProperties.Description="{x:Static strings:AppStrings.SortLabel}"
                            Style="{StaticResource IconButton}"
                            CornerRadius="14" BorderWidth="1"
                            BorderColor="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                            Clicked="OnSheetSortClicked">
                            <ImageButton.Source>
                                <FontImageSource Glyph="&#xE164;" FontFamily="MaterialOutlined" Size="20"
                                    Color="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                            </ImageButton.Source>
                        </ImageButton>
                    </Grid>

                    <!-- Folders -->
                    <VerticalStackLayout IsVisible="{Binding HasFolders}" Spacing="0">
                        <Grid ColumnDefinitions="*,Auto,Auto" Padding="20,4,8,0" HeightRequest="48">
                            <Label Grid.Column="0" Style="{StaticResource SectionLabel}" VerticalOptions="Center"
                                   Text="{x:Static strings:AppStrings.Folders}" />
                            <ImageButton
                                Grid.Column="1"
                                AutomationId="LibraryFolderSearchButton"
                                SemanticProperties.Description="{x:Static strings:AppStrings.SearchFoldersPlaceholder}"
                                Style="{StaticResource IconButton}"
                                IsVisible="{Binding HasMultipleFolders}"
                                Clicked="OnFolderSearchClicked">
                                <ImageButton.Source>
                                    <FontImageSource Glyph="&#xE8B6;" FontFamily="MaterialOutlined" Size="20"
                                        Color="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                                </ImageButton.Source>
                            </ImageButton>
                            <ImageButton
                                Grid.Column="2"
                                AutomationId="LibraryFolderSortButton"
                                SemanticProperties.Description="{x:Static strings:AppStrings.SortFoldersByTitle}"
                                Style="{StaticResource IconButton}"
                                IsVisible="{Binding HasMultipleFolders}"
                                Clicked="OnFolderSortClicked">
                                <ImageButton.Source>
                                    <FontImageSource Glyph="&#xE164;" FontFamily="MaterialOutlined" Size="20"
                                        Color="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                                </ImageButton.Source>
                            </ImageButton>
                        </Grid>

                        <Border
                            Margin="20,0,20,8"
                            HeightRequest="44"
                            Padding="14,0"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}"
                            IsVisible="{Binding IsFolderSearchVisible}">
                            <Grid ColumnDefinitions="*,Auto">
                                <Entry
                                    Grid.Column="0"
                                    x:Name="FolderSearchEntry"
                                    AutomationId="LibraryFolderSearchEntry"
                                    FontSize="15"
                                    VerticalOptions="Center"
                                    Placeholder="{x:Static strings:AppStrings.SearchFoldersPlaceholder}"
                                    PlaceholderColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                                    Text="{Binding FolderSearchText}" />
                                <ImageButton
                                    Grid.Column="1"
                                    Style="{StaticResource IconButton}"
                                    Margin="0,0,-14,0"
                                    IsVisible="{Binding FolderSearchText, Converter={StaticResource StringNotEmpty}}"
                                    Clicked="OnFolderSearchClearClicked">
                                    <ImageButton.Source>
                                        <FontImageSource Glyph="&#xE5CD;" FontFamily="MaterialOutlined" Size="20"
                                            Color="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                                    </ImageButton.Source>
                                </ImageButton>
                            </Grid>
                        </Border>

                        <!-- Built in code-behind (RebuildFolderGrid): gestures inside a FlexLayout/BindableLayout never fired on Android. -->
                        <Grid x:Name="FolderGrid" ColumnDefinitions="*,*,*" ColumnSpacing="10" RowSpacing="10" Margin="20,0,20,16" />
                    </VerticalStackLayout>

                    <Label
                        Style="{StaticResource SectionLabel}"
                        Padding="20,4,20,6"
                        Text="{x:Static strings:AppStrings.Sheets}"
                        IsVisible="{Binding HasSheetResults}" />

                    <!-- Compact empty state: search with no matches -->
                    <VerticalStackLayout IsVisible="{Binding HasNoSheetResults}" Spacing="4" Margin="32,40,32,24" AutomationId="LibraryNoResults">
                        <Image HorizontalOptions="Center" Margin="0,0,0,6">
                            <Image.Source>
                                <FontImageSource Glyph="&#xE8B6;" FontFamily="MaterialOutlined" Size="32"
                                    Color="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                            </Image.Source>
                        </Image>
                        <Label Style="{StaticResource RowTitle}" HorizontalTextAlignment="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                               Text="{x:Static strings:AppStrings.NoResultsTitle}" />
                        <Label Style="{StaticResource Caption}" HorizontalTextAlignment="Center"
                               Text="{x:Static strings:AppStrings.NoResultsMessage}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid AutomationId="LibrarySheetRow" ColumnDefinitions="*,Auto" Padding="20,8,8,8" BackgroundColor="Transparent">
                      <!-- Tap/long-press area; the more button is a sibling so its tap does not open the sheet. -->
                      <Grid x:Name="SheetItemRoot" ColumnDefinitions="Auto,*" ColumnSpacing="14" BackgroundColor="Transparent">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnSheetTapped" CommandParameter="{Binding}" />
                        </Grid.GestureRecognizers>
                        <Grid.Behaviors>
                            <toolkit:TouchBehavior
                                InteractionStatusChanged="OnItemTouchStatusChanged"
                                PressedOpacity="0.6"
                                LongPressCommand="{Binding Source={x:Reference ThisPage}, Path=SheetLongPressCommand}"
                                LongPressCommandParameter="{Binding Source={x:Reference SheetItemRoot}, Path=BindingContext}" />
                        </Grid.Behaviors>

                        <!-- Page-like thumbnail placeholder -->
                        <Border
                            Grid.Column="0"
                            WidthRequest="40" HeightRequest="54"
                            Padding="6,0"
                            StrokeShape="RoundRectangle 6"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource OutlineLight}, Dark=Transparent}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource TextPrimaryDark}}">
                            <VerticalStackLayout Spacing="5" VerticalOptions="Center">
                                <BoxView HeightRequest="1" Color="#9A9AAE" />
                                <BoxView HeightRequest="1" Color="#9A9AAE" />
                                <BoxView HeightRequest="1" Color="#9A9AAE" />
                                <BoxView HeightRequest="1" Color="#9A9AAE" />
                            </VerticalStackLayout>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <Label Style="{StaticResource RowTitle}" MaxLines="1" LineBreakMode="TailTruncation"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                   AutomationId="LibrarySheetTitle" Text="{Binding Title}" />
                            <Label Style="{StaticResource Caption}" MaxLines="1" LineBreakMode="TailTruncation"
                                   Text="{Binding ., Converter={StaticResource SheetMeta}}" />
                        </VerticalStackLayout>

                        </Grid>

                        <ImageButton
                            Grid.Column="1"
                            AutomationId="LibraryItemMoreButton"
                            SemanticProperties.Description="{x:Static strings:AppStrings.MoreOptions}"
                            Style="{StaticResource IconButton}"
                            VerticalOptions="Center"
                            Clicked="OnSheetMoreClicked">
                            <ImageButton.Source>
                                <FontImageSource Glyph="&#xE5D4;" FontFamily="MaterialOutlined" Size="20"
                                    Color="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                            </ImageButton.Source>
                        </ImageButton>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>

            <CollectionView.Footer>
                <Grid HeightRequest="16" />
            </CollectionView.Footer>
        </CollectionView>

        <!-- Empty state: nothing imported yet -->
        <VerticalStackLayout
            Grid.Row="0"
            IsVisible="{Binding IsEmpty}"
            VerticalOptions="Center"
            Margin="32,120,32,0"
            Spacing="8">
            <Image HorizontalOptions="Center" Margin="0,0,0,8">
                <Image.Source>
                    <FontImageSource Glyph="&#xE873;" FontFamily="MaterialOutlined" Size="48"
                        Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                </Image.Source>
            </Image>
            <Label Style="{StaticResource RowTitle}" FontSize="18" HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                   Text="{x:Static strings:AppStrings.EmptyLibraryTitle}" />
            <Label Style="{StaticResource Caption}" HorizontalTextAlignment="Center"
                   Text="{x:Static strings:AppStrings.EmptyLibraryMessage}" />
            <Button
                AutomationId="LibraryEmptyImportButton"
                Margin="0,12,0,0"
                HorizontalOptions="Center"
                Text="{x:Static strings:AppStrings.ImportPdf}"
                Clicked="OnImportPdfClicked" />
        </VerticalStackLayout>

        <Grid Grid.Row="1" IsVisible="{x:Static local:PlatformInfo.IsAndroid}">
            <admob:BannerAd IsVisible="{Binding ShowAdsBanner}" />
        </Grid>
    </Grid>
</ContentPage>
