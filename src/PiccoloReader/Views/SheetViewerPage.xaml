<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="PiccoloReader.Views.SheetViewerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:converters="clr-namespace:PiccoloReader.Converters"
    xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"
    xmlns:ctViews="clr-namespace:CommunityToolkit.Maui.Views;assembly=CommunityToolkit.Maui"
    xmlns:strings="clr-namespace:PiccoloReader.Core.Resources.Strings;assembly=PiccoloReader.Core"
    xmlns:admob="clr-namespace:Plugin.AdMob;assembly=Plugin.AdMob"
    xmlns:local="clr-namespace:PiccoloReader"
    x:Name="ThisPage"
    Shell.TabBarIsVisible="False"
    Shell.NavBarIsVisible="False"
    Title="{Binding Title}">


    <ContentPage.Resources>
        <converters:ByteArrayToImageSourceConverter x:Key="ByteArrayToImageSource" />
        <converters:StringNotEmptyConverter x:Key="StringNotEmpty" />
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">
    <Grid Grid.Row="0" BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Black}}">

        <Grid
            x:Name="PageContainer"
            HorizontalOptions="Center"
            VerticalOptions="Center">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnPageContainerTapped" />
                <PinchGestureRecognizer PinchUpdated="OnPinchUpdated" />
                <PanGestureRecognizer PanUpdated="OnPanUpdated" />
            </Grid.GestureRecognizers>

            <Image
                x:Name="PageImage"
                Source="{Binding CurrentPageImageBytes, Converter={StaticResource ByteArrayToImageSource}}"
                Aspect="AspectFit" />

            <skia:SKCanvasView x:Name="AnnotationCanvas" PaintSurface="OnAnnotationCanvasPaintSurface" />

            <Grid
                x:Name="SelectionOverlay"
                IsVisible="False"
                HorizontalOptions="Start"
                VerticalOptions="Start"
                InputTransparent="False">
                <Border
                    x:Name="SelectionBorder"
                    Margin="20"
                    Stroke="{StaticResource Primary}"
                    StrokeThickness="2"
                    BackgroundColor="Transparent">
                    <Border.GestureRecognizers>
                        <PanGestureRecognizer PanUpdated="OnSelectionMovePanUpdated" />
                    </Border.GestureRecognizers>
                </Border>

                <Border
                    x:Name="ResizeHandle"
                    WidthRequest="24"
                    HeightRequest="24"
                    BackgroundColor="{StaticResource Primary}"
                    StrokeThickness="0"
                    HorizontalOptions="Start"
                    VerticalOptions="Start">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <PanGestureRecognizer PanUpdated="OnSelectionResizePanUpdated" />
                    </Border.GestureRecognizers>
                </Border>
            </Grid>

            <ctViews:DrawingView
                x:Name="PencilDrawingView"
                IsVisible="False"
                InputTransparent="False"
                BackgroundColor="Transparent"
                ShouldClearOnFinish="True"
                DrawingLineStarted="OnPencilDrawingLineStarted"
                DrawingLineCompleted="OnPencilDrawingLineCompleted" />

            <ctViews:DrawingView
                x:Name="EraserDrawingView"
                IsVisible="False"
                InputTransparent="False"
                BackgroundColor="Transparent"
                ShouldClearOnFinish="True"
                DrawingLineStarted="OnEraserDrawingLineStarted"
                PointDrawn="OnEraserPointDrawn"
                DrawingLineCompleted="OnEraserDrawingLineCompleted"
                DrawingLineCancelled="OnEraserDrawingLineCancelled" />

            <Ellipse
                x:Name="EraserRadiusIndicator"
                IsVisible="False"
                InputTransparent="True"
                Fill="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
                Opacity="0.3"
                HorizontalOptions="Start"
                VerticalOptions="Start" />
        </Grid>

        <!-- Continuous (vertical scroll) reading mode. Items are built in
             code (ContinuousPageView) - see the page constructor. Zoom is a
             Scale/TranslationX on the list itself, clipped by this host. -->
        <Grid x:Name="ContinuousHost" IsVisible="False" IsClippedToBounds="True">
            <CollectionView
                x:Name="ContinuousPagesView"
                ItemsSource="{Binding ContinuousPages}"
                ItemSizingStrategy="MeasureAllItems"
                Scrolled="OnContinuousPagesScrolled">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="0" />
                </CollectionView.ItemsLayout>
                <CollectionView.Footer>
                    <BoxView x:Name="ContinuousZoomFooter" HeightRequest="0" Color="Transparent" />
                </CollectionView.Footer>
            </CollectionView>
        </Grid>

        <!-- Leaves the single-page editor and returns to the continuous list. -->
        <Border
            x:Name="ContinuousEditDoneButton"
            IsVisible="False"
            WidthRequest="56"
            HeightRequest="56"
            Margin="16,0,0,16"
            HorizontalOptions="Start"
            VerticalOptions="End"
            BackgroundColor="{StaticResource Primary}"
            StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="28" />
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnContinuousEditDoneTapped" />
            </Border.GestureRecognizers>
            <Image HorizontalOptions="Center" VerticalOptions="Center">
                <Image.Source>
                    <FontImageSource Glyph="&#xE876;" FontFamily="MaterialOutlined" Size="26" Color="White" />
                </Image.Source>
            </Image>
        </Border>

        <Border
            x:Name="PageIndicator"
            AutomationId="ViewerPageIndicator"
            VerticalOptions="End"
            HorizontalOptions="Center"
            Margin="0,0,0,36"
            HeightRequest="36"
            Padding="16,0"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 18"
            Stroke="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}"
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnPageIndicatorTapped" />
            </Border.GestureRecognizers>
            <Label
                Text="{Binding PageIndicatorText}"
                FontSize="13"
                FontFamily="OpenSansSemibold"
                VerticalOptions="Center"
                HorizontalTextAlignment="Center"
                TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
        </Border>


        <ActivityIndicator
            IsRunning="{Binding IsLoading}"
            IsVisible="{Binding IsLoading}"
            HorizontalOptions="Center"
            VerticalOptions="Center" />

        <Border
            x:Name="TrashTarget"
            IsVisible="False"
            WidthRequest="56"
            HeightRequest="56"
            Margin="0,0,0,88"
            HorizontalOptions="Center"
            VerticalOptions="End"
            BackgroundColor="{StaticResource Primary}"
            StrokeThickness="0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="28" />
            </Border.StrokeShape>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnTrashTargetTapped" />
            </Border.GestureRecognizers>
            <Image HorizontalOptions="Center" VerticalOptions="Center">
                <Image.Source>
                    <FontImageSource Glyph="&#xE872;" FontFamily="MaterialOutlined" Size="26" Color="White" />
                </Image.Source>
            </Image>
        </Border>

        <Border
            x:Name="ToolPanel"
            IsVisible="False"
            WidthRequest="260"
            Margin="0,80,0,0"
            HorizontalOptions="End"
            VerticalOptions="Fill"
            BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"
            StrokeThickness="0">
            <Grid>

                <ScrollView>
                    <Grid Padding="12">

                        <VerticalStackLayout x:Name="MusicIconsSection" Spacing="4">
                            <Label Text="{x:Static strings:AppStrings.MusicIcons}" FontAttributes="Bold" FontSize="16" Margin="0,0,0,8" />
                            <CollectionView ItemsSource="{Binding Source={x:Reference ThisPage}, Path=IconCategories}">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <VerticalStackLayout Spacing="4" Margin="0,0,0,12">
                                            <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="14" />
                                            <FlexLayout Wrap="Wrap" Direction="Row" BindableLayout.ItemsSource="{Binding Icons}">
                                                <BindableLayout.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border
                                                            WidthRequest="52"
                                                            HeightRequest="52"
                                                            Margin="4"
                                                            Padding="4"
                                                            BackgroundColor="{StaticResource White}"
                                                            StrokeThickness="1">
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer
                                                                    Tapped="OnIconPickerTapped"
                                                                    CommandParameter="{Binding Key}" />
                                                            </Border.GestureRecognizers>
                                                            <skia:SKCanvasView
                                                                WidthRequest="40"
                                                                HeightRequest="40"
                                                                HorizontalOptions="Center"
                                                                VerticalOptions="Center"
                                                                PaintSurface="OnIconGlyphPaintSurface" />
                                                        </Border>
                                                    </DataTemplate>
                                                </BindableLayout.ItemTemplate>
                                            </FlexLayout>
                                        </VerticalStackLayout>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="PencilSection" IsVisible="False" Spacing="8">
                            <Label Text="{x:Static strings:AppStrings.Pencil}" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{x:Static strings:AppStrings.Color}" FontSize="14" />
                            <HorizontalStackLayout Spacing="10">
                                <Border
                                    x:Name="ColorRingBlack"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    StrokeThickness="2"
                                    Stroke="Transparent"
                                    BackgroundColor="Transparent"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20" />
                                    </Border.StrokeShape>
                                    <Border
                                        WidthRequest="28"
                                        HeightRequest="28"
                                        BackgroundColor="Black"
                                        StrokeThickness="0"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnPencilColorTapped" CommandParameter="#000000" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                </Border>
                                <Border
                                    x:Name="ColorRingRed"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    StrokeThickness="2"
                                    Stroke="Transparent"
                                    BackgroundColor="Transparent"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20" />
                                    </Border.StrokeShape>
                                    <Border
                                        WidthRequest="28"
                                        HeightRequest="28"
                                        BackgroundColor="Red"
                                        StrokeThickness="0"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnPencilColorTapped" CommandParameter="#FF0000" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                </Border>
                                <Border
                                    x:Name="ColorRingBlue"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    StrokeThickness="2"
                                    Stroke="Transparent"
                                    BackgroundColor="Transparent"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20" />
                                    </Border.StrokeShape>
                                    <Border
                                        WidthRequest="28"
                                        HeightRequest="28"
                                        BackgroundColor="Blue"
                                        StrokeThickness="0"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnPencilColorTapped" CommandParameter="#0000FF" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                </Border>
                                <Border
                                    x:Name="ColorRingGreen"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    StrokeThickness="2"
                                    Stroke="Transparent"
                                    BackgroundColor="Transparent"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20" />
                                    </Border.StrokeShape>
                                    <Border
                                        WidthRequest="28"
                                        HeightRequest="28"
                                        BackgroundColor="Green"
                                        StrokeThickness="0"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnPencilColorTapped" CommandParameter="#008000" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                </Border>
                                <Border
                                    x:Name="ColorRingOrange"
                                    WidthRequest="40"
                                    HeightRequest="40"
                                    StrokeThickness="2"
                                    Stroke="Transparent"
                                    BackgroundColor="Transparent"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="20" />
                                    </Border.StrokeShape>
                                    <Border
                                        WidthRequest="28"
                                        HeightRequest="28"
                                        BackgroundColor="Orange"
                                        StrokeThickness="0"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnPencilColorTapped" CommandParameter="#FFA500" />
                                        </Border.GestureRecognizers>
                                    </Border>
                                </Border>
                            </HorizontalStackLayout>
                            <Label Text="{x:Static strings:AppStrings.Width}" FontSize="14" />
                            <skia:SKCanvasView
                                x:Name="PencilWidthPreview"
                                HeightRequest="48"
                                HorizontalOptions="Fill"
                                Margin="0,4"
                                PaintSurface="OnPencilWidthPreviewPaintSurface" />
                            <Slider x:Name="PencilWidthSlider" Minimum="0.003" Maximum="0.02" Value="{Binding PencilStrokeWidth}" ValueChanged="OnPencilWidthChanged" />
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="EraserSection" IsVisible="False" Spacing="8">
                            <Label Text="{x:Static strings:AppStrings.Eraser}" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{x:Static strings:AppStrings.Size}" FontSize="14" />
                            <skia:SKCanvasView
                                x:Name="EraserSizePreview"
                                HeightRequest="80"
                                HorizontalOptions="Fill"
                                Margin="0,4"
                                PaintSurface="OnEraserSizePreviewPaintSurface" />
                            <Slider x:Name="EraserRadiusSlider" Minimum="0.02" Maximum="0.08" Value="{Binding EraserRadius}" ValueChanged="OnEraserRadiusChanged" />
                        </VerticalStackLayout>

                    </Grid>
                </ScrollView>
            </Grid>
        </Border>

        <!-- Tool speed-dial FAB: main FAB toggles 3 mini buttons above it (Icons/Pencil/Eraser). -->
        <Border
            x:Name="IconsFab"
            AutomationId="ViewerToolIcons"
            IsVisible="False"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,24,204"
            WidthRequest="48"
            HeightRequest="48"
            Padding="0"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 24"
            Stroke="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}"
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceRaisedDark}}">
            <Border.Shadow>
                <Shadow Brush="{StaticResource Black}" Opacity="0.2" Radius="6" Offset="0,3" />
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnFabIconsClicked" />
            </Border.GestureRecognizers>
            <Image HorizontalOptions="Center" VerticalOptions="Center">
                <Image.Source>
                    <FontImageSource Glyph="&#xE405;" FontFamily="MaterialOutlined" Size="24" Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                </Image.Source>
            </Image>
        </Border>

        <Border
            x:Name="PencilFab"
            AutomationId="ViewerToolPencil"
            IsVisible="False"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,24,148"
            WidthRequest="48"
            HeightRequest="48"
            Padding="0"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 24"
            Stroke="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}"
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceRaisedDark}}">
            <Border.Shadow>
                <Shadow Brush="{StaticResource Black}" Opacity="0.2" Radius="6" Offset="0,3" />
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnFabPencilClicked" />
            </Border.GestureRecognizers>
            <Image HorizontalOptions="Center" VerticalOptions="Center">
                <Image.Source>
                    <FontImageSource Glyph="&#xE3C9;" FontFamily="MaterialOutlined" Size="24" Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                </Image.Source>
            </Image>
        </Border>

        <Border
            x:Name="EraserFab"
            AutomationId="ViewerToolEraser"
            IsVisible="False"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,24,92"
            WidthRequest="48"
            HeightRequest="48"
            Padding="0"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 24"
            Stroke="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}"
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceRaisedDark}}">
            <Border.Shadow>
                <Shadow Brush="{StaticResource Black}" Opacity="0.2" Radius="6" Offset="0,3" />
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnFabEraserClicked" />
            </Border.GestureRecognizers>
            <Image HorizontalOptions="Center" VerticalOptions="Center">
                <Image.Source>
                    <FontImageSource Glyph="&#xE6D0;" FontFamily="MaterialOutlined" Size="24" Color="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" />
                </Image.Source>
            </Image>
        </Border>

        <Border
            x:Name="MainToolFab"
            AutomationId="ViewerToolsFab"
            SemanticProperties.Description="{x:Static strings:AppStrings.AnnotationToolsLabel}"
            HorizontalOptions="End"
            VerticalOptions="End"
            Margin="0,0,20,24"
            WidthRequest="56"
            HeightRequest="56"
            Padding="0"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 18"
            BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}">
            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light={StaticResource PrimaryLight}, Dark={StaticResource PrimaryDark}}" Opacity="0.3" Radius="10" Offset="0,4" />
            </Border.Shadow>
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnMainToolFabClicked" />
            </Border.GestureRecognizers>
            <Image x:Name="MainToolFabIcon" HorizontalOptions="Center" VerticalOptions="Center">
                <Image.Source>
                    <FontImageSource x:Name="MainToolFabGlyph" Glyph="&#xE3C9;" FontFamily="MaterialOutlined" Size="24" Color="{AppThemeBinding Light={StaticResource OnPrimaryLight}, Dark={StaticResource OnPrimaryDark}}" />
                </Image.Source>
            </Image>
        </Border>

        <!-- Floating top bar (replaces the Shell nav bar). Only the pill itself
             is hit-testable, so touches around it reach the page. -->
        <Border
            x:Name="FloatingBar"
            VerticalOptions="Start"
            Margin="12"
            HeightRequest="56"
            Padding="6,0"
            StrokeThickness="1"
            StrokeShape="RoundRectangle 28"
            Stroke="{AppThemeBinding Light={StaticResource OutlineLight}, Dark={StaticResource OutlineDark}}"
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="2">
                <ImageButton
                    x:Name="BackButton"
                    Grid.Column="0"
                    Style="{StaticResource IconButton}"
                    AutomationId="ViewerBackButton"
                    SemanticProperties.Description="{x:Static strings:AppStrings.BackLabel}"
                    Clicked="OnBackClicked">
                    <ImageButton.Source>
                        <FontImageSource Glyph="&#xE5C4;" FontFamily="MaterialOutlined" Size="24" Color="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                    </ImageButton.Source>
                </ImageButton>

                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="4,0">
                    <Label
                        AutomationId="ViewerTitleLabel"
                        Text="{Binding Title}"
                        Style="{StaticResource RowTitle}"
                        MaxLines="1"
                        LineBreakMode="TailTruncation"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                    <Label
                        x:Name="ReadingModeNameLabel"
                        Style="{StaticResource Caption}"
                        FontSize="12"
                        MaxLines="1"
                        LineBreakMode="TailTruncation" />
                </VerticalStackLayout>

                <ImageButton
                    x:Name="ReadingModeButton"
                    Grid.Column="2"
                    Style="{StaticResource IconButton}"
                    AutomationId="ViewerModeButton"
                    SemanticProperties.Description="{x:Static strings:AppStrings.ReadingModeLabel}"
                    Clicked="OnReadingModeClicked">
                    <ImageButton.Source>
                        <FontImageSource x:Name="ReadingModeIcon" Glyph="&#xE8D4;" FontFamily="MaterialOutlined" Size="24" Color="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                    </ImageButton.Source>
                </ImageButton>

                <ImageButton
                    x:Name="BookmarkButton"
                    Grid.Column="3"
                    Style="{StaticResource IconButton}"
                    AutomationId="ViewerBookmarkButton"
                    SemanticProperties.Description="{x:Static strings:AppStrings.BookmarksTitle}"
                    Clicked="OnBookmarksClicked" />

                <ImageButton
                    x:Name="MoreButton"
                    Grid.Column="4"
                    Style="{StaticResource IconButton}"
                    AutomationId="ViewerMoreButton"
                    SemanticProperties.Description="{x:Static strings:AppStrings.MoreOptions}"
                    Clicked="OnMoreClicked">
                    <ImageButton.Source>
                        <FontImageSource Glyph="&#xE5D4;" FontFamily="MaterialOutlined" Size="24" Color="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                    </ImageButton.Source>
                </ImageButton>
            </Grid>
        </Border>

        <Grid x:Name="AddBookmarkOverlay" IsVisible="False">
            <BoxView BackgroundColor="Black" Opacity="0.4">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAddBookmarkCancelClicked" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <Border
                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"
                Padding="20"
                Margin="32"
                VerticalOptions="Center"
                HorizontalOptions="Fill"
                StrokeThickness="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="{x:Static strings:AppStrings.AddBookmarkOption}" FontAttributes="Bold" FontSize="18" />

                    <Label Text="{x:Static strings:AppStrings.PageNumberLabel}" FontSize="14" />
                    <Entry x:Name="AddBookmarkPageEntry" Keyboard="Numeric" />

                    <Label Text="{x:Static strings:AppStrings.NameOptionalLabel}" FontSize="14" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Entry x:Name="AddBookmarkNameEntry" Grid.Column="0" Placeholder="{x:Static strings:AppStrings.NamePlaceholderExample}" />
                        <Border
                            Grid.Column="1"
                            Padding="6"
                            StrokeThickness="0"
                            BackgroundColor="Transparent"
                            IsVisible="{Binding Source={x:Reference AddBookmarkNameEntry}, Path=Text, Converter={StaticResource StringNotEmpty}}">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnAddBookmarkNameClearClicked" />
                            </Border.GestureRecognizers>
                            <Image>
                                <Image.Source>
                                    <FontImageSource
                                        Glyph="&#xE5CD;"
                                        FontFamily="MaterialOutlined"
                                        Size="18"
                                        Color="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                </Image.Source>
                            </Image>
                        </Border>
                    </Grid>

                    <HorizontalStackLayout Spacing="16" HorizontalOptions="End" Margin="0,8,0,0">
                        <Button Text="{x:Static strings:AppStrings.Cancel}" Clicked="OnAddBookmarkCancelClicked" BackgroundColor="Transparent" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                        <Button Text="{x:Static strings:AppStrings.Add}" Clicked="OnAddBookmarkConfirmClicked" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>

    </Grid>

    <Grid Grid.Row="1" IsVisible="{x:Static local:PlatformInfo.IsAndroid}">
        <admob:BannerAd IsVisible="{Binding ShowAdsBanner}" />
    </Grid>
    </Grid>
</ContentPage>
