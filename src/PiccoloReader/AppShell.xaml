<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="PiccoloReader.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:PiccoloReader.Views"
    xmlns:strings="clr-namespace:PiccoloReader.Core.Resources.Strings;assembly=PiccoloReader.Core"
    xmlns:local="clr-namespace:PiccoloReader"
    FlyoutBehavior="Disabled"
    Shell.BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundLight}, Dark={StaticResource BackgroundDark}}"
    Shell.ForegroundColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
    Shell.TitleColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
    Title="PiccoloReader">

    <!--
        Bottom tab bar replaces the old flyout. Pushed pages (folder, sheet
        viewer, ...) are registered routes and hide the tab bar via
        Shell.TabBarIsVisible="False" on the page.
    -->
    <TabBar>
        <Tab AutomationId="TabLibrary" Title="{x:Static strings:AppStrings.Library}" Route="library">
            <Tab.Icon>
                <FontImageSource Glyph="&#xE2C7;" FontFamily="MaterialOutlined" Size="24" Color="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:LibraryPage}" />
        </Tab>

        <Tab
            Title="{x:Static strings:AppStrings.DonateMenuItem}"
            Route="donate"
            IsVisible="{x:Static local:PlatformInfo.IsAndroid}">
            <Tab.Icon>
                <FontImageSource Glyph="&#xE87E;" FontFamily="MaterialOutlined" Size="24" Color="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:DonatePage}" />
        </Tab>

        <Tab AutomationId="TabSettings" Title="{x:Static strings:AppStrings.Settings}" Route="settings">
            <Tab.Icon>
                <FontImageSource Glyph="&#xE429;" FontFamily="MaterialOutlined" Size="24" Color="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
            </Tab.Icon>
            <ShellContent ContentTemplate="{DataTemplate views:SettingsPage}" />
        </Tab>
    </TabBar>

</Shell>
