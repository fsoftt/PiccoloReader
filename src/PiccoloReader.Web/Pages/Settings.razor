@page "/settings"
@using PiccoloReader.Core.Services.Tuner
@implements IDisposable
@inject AppCulture Culture
@inject UiService Ui
@inject NavigationManager Nav
@inject IConcertModePreferenceService Concert
@inject IReadingPreferenceService Reading
@inject PiccoloReader.Core.Services.Stylus.IStylusPreferenceService Stylus
@inject IConcertTutorialPreferenceService CoachPrefs
@inject ITunerStripPreferenceService StripPrefs
@inject PwaService Pwa
@inject BackupService Backup
@inject LinkedFolderService Linked
@inject BrowserInterop Browser

<div class="page">
    <div class="header"><h1 class="page-title">@AppStrings.Settings</h1></div>

    <div class="settings">
        @if (_busy is not null)
        {
            <div class="card progress-card" role="status" data-testid="progress">
                <span class="row-title" data-testid="progress-text">@_busy</span>
                <div class="bar"><i></i></div>
            </div>
        }

        <span class="section-label">@AppStrings.SettingsGeneralSection</span>
        <div class="card group">
            <button class="row" data-testid="language-row" aria-label="@AppStrings.LanguageSectionHeader" @onclick="PickLanguageAsync">
                <Icon G="E894" Class="s20 c-primary" />
                <span class="stack"><span class="row-title">@AppStrings.LanguageSectionHeader</span></span>
                <span class="value" data-testid="language-value">@(Culture.Code == "es" ? "Español" : "English")</span>
                <Icon G="E5CC" Class="s20 c-muted" />
            </button>
            <button class="row" data-testid="reading-mode-row" @onclick="PickReadingModeAsync">
                <Icon G="E8D4" Class="s20 c-primary" />
                <span class="stack"><span class="row-title">@AppStrings.ReadingModeLabel</span></span>
                <span class="value" data-testid="reading-mode-value">@ModeName(Reading.GetReadingMode())</span>
                <Icon G="E5CC" Class="s20 c-muted" />
            </button>
            @if (_penSeen || _stylus)
            {
            <button class="row" data-testid="stylus-row" role="switch" aria-checked="@_stylus.ToString().ToLowerInvariant()" @onclick="ToggleStylus">
                <Icon G="E3C9" Class="s20 c-primary" />
                <span class="stack">
                    <span class="row-title">@AppStrings.StylusDrawsDirectlyLabel</span>
                    <span class="caption" style="font-size:12px">@AppStrings.StylusDrawsDirectlyDescription</span>
                </span>
                <span class="switch @(_stylus ? "on" : "")"></span>
            </button>
            }
            <button class="row" data-testid="shapes-row" role="switch" aria-checked="@_shapes.ToString().ToLowerInvariant()" @onclick="ToggleShapes">
                <Icon G="E663" Class="s20 c-primary" />
                <span class="stack">
                    <span class="row-title">@AppStrings.RecognizeShapesLabel</span>
                    <span class="caption" style="font-size:12px">@AppStrings.RecognizeShapesDescription</span>
                </span>
                <span class="switch @(_shapes ? "on" : "")"></span>
            </button>
            <button class="row" data-testid="strip-position-row" aria-label="@AppStrings.TunerStripPositionLabel" @onclick="PickStripPositionAsync">
                <Icon G="E8D4" Class="s20 c-primary" />
                <span class="stack"><span class="row-title">@AppStrings.TunerStripPositionLabel</span></span>
                <span class="value" data-testid="strip-position-value">@StripName(StripPrefs.Position)</span>
                <Icon G="E5CC" Class="s20 c-muted" />
            </button>
            <button class="row" data-testid="concert-row" role="switch" aria-checked="@_concert.ToString().ToLowerInvariant()" @onclick="ToggleConcert">
                <Icon G="E03D" Class="s20 c-primary" />
                <span class="stack">
                    <span class="row-title">@AppStrings.ConcertModeLabel</span>
                    <span class="caption" style="font-size:12px">@AppStrings.ConcertModeDescription</span>
                </span>
                <span class="switch @(_concert ? "on" : "")"></span>
            </button>
            <button class="row" data-testid="concert-tutorial-row" role="switch" aria-checked="@_coach.ToString().ToLowerInvariant()" @onclick="ToggleCoach">
                <Icon G="E80C" Class="s20 c-primary" />
                <span class="stack">
                    <span class="row-title">@AppStrings.ConcertTutorialLabel</span>
                    <span class="caption" style="font-size:12px">@AppStrings.ConcertTutorialDescription</span>
                </span>
                <span class="switch @(_coach ? "on" : "")"></span>
            </button>
        </div>

        <span class="section-label">@AppStrings.SettingsStorageSection</span>
        <div class="card group">
            <button class="row" data-testid="storage-row" @onclick="ProtectStorageAsync">
                <Icon G="E1DB" Class="s20 c-primary" />
                <span class="stack">
                    <span class="row-title">@WebText.BrowserStorage</span>
                    <span class="caption" style="font-size:12px" data-testid="storage-usage">@(_storage is null ? "" : WebText.StorageUsage(WebText.FormatBytes(_storage.Usage), WebText.FormatBytes(_storage.Quota)))</span>
                    <span class="caption" style="font-size:12px" data-testid="storage-persisted">@(_storage is null ? "" : _storage.Persisted ? WebText.StoragePersisted : WebText.StorageNotPersisted)</span>
                </span>
            </button>
            @if (Linked.Supported)
            {
                <button class="row" data-testid="linked-row" @onclick="LinkedFolderAsync">
                    <Icon G="E2C7" Class="s20 c-primary" />
                    <span class="stack">
                        <span class="row-title">@WebText.LinkedFolder</span>
                        <span class="caption" style="font-size:12px" data-testid="linked-status">@LinkedStatus()</span>
                    </span>
                    <Icon G="E5CC" Class="s20 c-muted" />
                </button>
            }
        </div>

        <span class="section-label">@WebText.BackupSection</span>
        <div class="card group">
            <button class="row" data-testid="export-row" disabled="@(_busy is not null)" @onclick="ExportAsync">
                <Icon G="E2C4" Class="s20 c-primary" />
                <span class="stack">
                    <span class="row-title">@WebText.ExportLibrary</span>
                    <span class="caption" style="font-size:12px">@WebText.ExportLibraryDescription</span>
                </span>
            </button>
            <label class="row file-btn" data-testid="import-row">
                <Icon G="E2C6" Class="s20 c-primary" />
                <span class="stack">
                    <span class="row-title">@WebText.ImportLibrary</span>
                    <span class="caption" style="font-size:12px">@WebText.ImportLibraryDescription</span>
                </span>
                <InputFile OnChange="ImportBackupAsync" accept=".zip,application/zip" disabled="@(_busy is not null)" data-testid="import-backup" />
            </label>
        </div>

        <span class="section-label">@AppStrings.SettingsHelpSection</span>
        <div class="card group">
            @if ((Pwa.CanInstall && !Pwa.IsStandalone) || Pwa.NeedsIosInstallHelp)
            {
                <button class="row" data-testid="install-row" @onclick="InstallAsync">
                    <Icon G="E1FE" Class="s20 c-primary" />
                    <span class="stack">
                        <span class="row-title">@WebText.InstallApp</span>
                        <span class="caption" style="font-size:12px">@WebText.InstallAppDescription</span>
                    </span>
                </button>
            }
            <button class="row" data-testid="tutorial-row" @onclick="@(() => Nav.NavigateTo("tutorial"))">
                <Icon G="E8FD" Class="s20 c-primary" />
                <span class="stack"><span class="row-title">@AppStrings.ShowTutorial</span></span>
                <Icon G="E5CC" Class="s20 c-muted" />
            </button>
        </div>

        <span class="section-label">@AppStrings.LegalSectionHeader</span>
        <div class="card group">
            <a class="row" target="_blank" rel="noopener" href="@LegalLinks.GetPrivacyPolicyUrl(Culture.Code)">
                <Icon G="E32A" Class="s20 c-primary" />
                <span class="stack">
                    <span class="row-title">@AppStrings.PrivacyPolicyLabel</span>
                    <span class="caption" style="font-size:12px">@AppStrings.PrivacyPolicyDescription</span>
                </span>
                <Icon G="E89E" Class="s20 c-muted" />
            </a>
            <a class="row" target="_blank" rel="noopener" href="@LegalLinks.GetTermsOfServiceUrl(Culture.Code)">
                <Icon G="E873" Class="s20 c-primary" />
                <span class="stack">
                    <span class="row-title">@AppStrings.TermsOfServiceLabel</span>
                    <span class="caption" style="font-size:12px">@AppStrings.TermsOfServiceDescription</span>
                </span>
                <Icon G="E89E" Class="s20 c-muted" />
            </a>
            <a class="row" target="_blank" rel="noopener" href="https://github.com/fsoftt/PiccoloReader/blob/main/licenses/MuseScore_General-LICENSE.md">
                <Icon G="E405" Class="s20 c-primary" />
                <span class="stack">
                    <span class="row-title">@AppStrings.SettingsMuseScoreCreditTitle</span>
                    <span class="caption" style="font-size:12px">@AppStrings.SettingsMuseScoreCreditDescription</span>
                </span>
                <Icon G="E89E" Class="s20 c-muted" />
            </a>
            <a class="row" target="_blank" rel="noopener" href="https://github.com/fsoftt/PiccoloReader/blob/main/licenses/MeltySynth-LICENSE.txt">
                <Icon G="E322" Class="s20 c-primary" />
                <span class="stack">
                    <span class="row-title">@AppStrings.SettingsMeltySynthCreditTitle</span>
                    <span class="caption" style="font-size:12px">@AppStrings.SettingsMeltySynthCreditDescription</span>
                </span>
                <Icon G="E89E" Class="s20 c-muted" />
            </a>
        </div>

        <div class="credits caption" style="font-size:12px">
            <span>@AppStrings.MadeWithLoveBy <a href="https://github.com/fsoftt" target="_blank" rel="noopener">@@fsoftt</a></span>
            <span>@AppStrings.TestedWithLoveBy <a href="https://github.com/Giomelchors" target="_blank" rel="noopener">@@giomelchors</a></span>
        </div>
    </div>
</div>

@code {
    private bool _concert, _stylus, _shapes, _penSeen;
    private bool _coach;
    private string? _busy;
    private StorageInfo? _storage;

    private IProgress<string> Report => new Progress<string>(text => { _busy = text; StateHasChanged(); });

    protected override async Task OnInitializedAsync()
    {
        _concert = Concert.Enabled;
        _stylus = Stylus.DrawsDirectly; _penSeen = Browser.GetLocalStorageSync("piccolo.penSeen") == "1";
        _shapes = Stylus.RecognizesShapes;
        // The web guide has the library stage only, so it is pending until that one was seen.
        _coach = ConcertTutorialPolicy.IsTutorialPending(CoachPrefs);
        Pwa.Changed += OnPwaChanged;
        Linked.Changed += OnPwaChanged;
        _storage = await Pwa.GetStorageAsync();
    }

    private void OnPwaChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Pwa.Changed -= OnPwaChanged;
        Linked.Changed -= OnPwaChanged;
    }

    private void ToggleStylus() { _stylus = !_stylus; Stylus.DrawsDirectly = _stylus; }

    private void ToggleShapes() { _shapes = !_shapes; Stylus.RecognizesShapes = _shapes; }

    private static string ModeName(ReadingMode m) => m switch
    {
        ReadingMode.VerticalPaged => AppStrings.ReadingModeNameVerticalPaged,
        ReadingMode.VerticalContinuous => AppStrings.ReadingModeNameVerticalContinuous,
        _ => AppStrings.ReadingModeNameHorizontal,
    };

    private static readonly TunerStripPosition[] StripPositions =
    [
        TunerStripPosition.Left,
        TunerStripPosition.Right,
        TunerStripPosition.Bottom,
        TunerStripPosition.Top,
    ];

    private static string StripName(TunerStripPosition p) => p switch
    {
        TunerStripPosition.Left => AppStrings.TunerStripPositionLeft,
        TunerStripPosition.Bottom => AppStrings.TunerStripPositionBottom,
        TunerStripPosition.Top => AppStrings.TunerStripPositionTop,
        _ => AppStrings.TunerStripPositionRight,
    };

    private async Task PickLanguageAsync()
    {
        var pick = await Ui.ChooseAsync(AppStrings.LanguageSectionHeader, ["English", "Español"], AppStrings.Cancel);
        if (pick is null) return;
        var code = pick == "Español" ? "es" : "en";
        if (code == Culture.Code) return;
        // Like the Android app (restart required): the new language applies on a fresh load,
        // when the matching AppStrings satellite resources are picked up.
        Culture.Set(code);
        await Ui.AlertAsync(AppStrings.RestartRequiredTitle, AppStrings.RestartRequiredMessage, AppStrings.OK);
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }

    private async Task PickReadingModeAsync()
    {
        var modes = new[] { ReadingMode.Horizontal, ReadingMode.VerticalPaged, ReadingMode.VerticalContinuous };
        var pick = await Ui.ChooseAsync(AppStrings.ReadingModeLabel, modes.Select(ModeName).ToList(), AppStrings.Cancel);
        var mode = modes.FirstOrDefault(m => ModeName(m) == pick);
        if (pick is null) return;
        Reading.SetReadingMode(mode);
    }

    private async Task PickStripPositionAsync()
    {
        var pick = await Ui.ChooseAsync(AppStrings.TunerStripPositionLabel, StripPositions.Select(StripName).ToList(), AppStrings.Cancel);
        if (pick is null) return;
        StripPrefs.Position = StripPositions.First(p => StripName(p) == pick);
    }

    private void ToggleConcert()
    {
        _concert = !_concert;
        Concert.Enabled = _concert;
    }

    private void ToggleCoach()
    {
        _coach = !_coach;
        if (_coach) CoachPrefs.Reset();
        else { CoachPrefs.LibrarySeen = true; CoachPrefs.ViewerSeen = true; }
    }

    private async Task ProtectStorageAsync()
    {
        if (_storage is { Persisted: false })
        {
            var granted = await Browser.RequestPersistentStorageAsync();
            Ui.ShowToast(granted ? WebText.StorageProtected : WebText.StorageNotGranted);
        }
        _storage = await Pwa.GetStorageAsync();
    }

    private async Task InstallAsync()
    {
        if (Pwa.NeedsIosInstallHelp) { await Ui.ShowIosInstallAsync(WebText.IosInstallTitle, WebText.GotIt); return; }
        await Pwa.PromptInstallAsync();
    }

    private string LinkedStatus() => Linked.Linked switch
    {
        null => WebText.LinkedFolderDescription,
        { State: "granted" } l => WebText.LinkedFolderActive(l.Name),
        var l => WebText.LinkedFolderNeedsAccess(l.Name),
    };

    private async Task LinkedFolderAsync()
    {
        try
        {
            if (Linked.Linked is null)
            {
                var (_, cancelled) = await Linked.LinkAsync(Report);
                if (!cancelled) Ui.ShowToast(WebText.LinkedFolderSaved);
            }
            else if (!Linked.Active)
            {
                var ok = await Linked.ReconnectAsync(Report);
                Ui.ShowToast(ok ? WebText.LinkedFolderSaved : WebText.LinkedFolderDenied);
            }
            else
            {
                var pick = await Ui.ChooseAsync(WebText.LinkedFolder, [WebText.LinkedFolderUnlink], AppStrings.Cancel);
                if (pick is null) return;
                if (await Ui.ConfirmAsync(WebText.LinkedFolderUnlink, WebText.LinkedFolderUnlinkMessage, WebText.LinkedFolderUnlink, AppStrings.Cancel))
                {
                    await Linked.UnlinkAsync();
                }
            }
        }
        catch (Exception ex)
        {
            Ui.ShowToast(ex.Message);
        }
        finally
        {
            _busy = null;
        }
    }

    private async Task ExportAsync()
    {
        try
        {
            var done = await Backup.ExportAsync(Report);
            Ui.ShowToast(done ? WebText.ExportDone : WebText.ExportEmpty);
        }
        catch (Exception ex)
        {
            Ui.ShowToast(ex.Message);
        }
        finally
        {
            _busy = null;
        }
    }

    private async Task ImportBackupAsync(InputFileChangeEventArgs e)
    {
        var file = e.File;
        try
        {
            await using var stream = file.OpenReadStream(4L * 1024 * 1024 * 1024);
            var result = await Backup.ImportAsync(stream, Report);
            if (result is null) Ui.ShowToast(WebText.ImportFailed);
            else if (!result.FoundAnything) Ui.ShowToast(AppStrings.RecoverNothingFound);
            else Ui.ShowToast(AppStrings.RecoverResult(result.SheetsRestored + result.OrphansImported, result.FoldersAdded, result.AnnotationsAdded, result.BookmarksAdded, result.CropsAdded));
        }
        catch (Exception ex)
        {
            Ui.ShowToast(ex.Message);
        }
        finally
        {
            _busy = null;
        }
    }
}
